#!/usr/bin/env bash
# cw-claude-token — mint and cache a GitHub App installation access token for the
# cw-claude workbench identity. Prints a usable token to stdout.
#
# WHY: a GitHub App has no static token. You sign a short-lived JWT with the app's
# private key, exchange it for an installation access token (~1h), and use that as
# the git/gh credential. Tokens expire, so this caches the token and only re-mints
# when it is near expiry — cheap enough to call on every git operation and every
# login shell. It is the whole of the box's GitHub identity (replaces the old PAT).
#
# Config via the environment (set by the claude role's workbench env):
#   CW_CLAUDE_APP_ID       the GitHub App's ID (numeric)         [required]
#   CW_CLAUDE_APP_KEY      path to the app private key PEM        [required]
#   CW_CLAUDE_TOKEN_CACHE  cache file (default ~/.cache/cw-claude/token.json)
#   CW_CLAUDE_API          GitHub API base (default https://api.github.com)
#   CW_CLAUDE_TOKEN_SKEW   re-mint when fewer than N seconds remain (default 300)
#
# Exit non-zero on any failure so the git credential helper / gh see no token
# rather than a stale one.
set -uo pipefail

log() { echo "cw-claude-token: $*" >&2; }

# base64url with no padding, the JWT/JWS encoding. Filter: stdin -> stdout.
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# Pure: is a cached token still worth using, or should we re-mint? Mirrors the
# GitHub token lifetime as an epoch second; re-mint once inside the skew window.
token_fresh() { # <expires_epoch> <now_epoch> <skew_seconds> -> "fresh"|"stale"
  local exp="${1:-0}" now="${2:-0}" skew="${3:-300}"
  if [ "$exp" -gt "$((now + skew))" ]; then echo fresh; else echo stale; fi
}

# Pure: the JWT claim set. iat 60s back for clock drift; exp 9 min out (the API
# caps it at 10). iss is the app id. `now` is injected so this is testable.
jwt_payload() { # <app_id> <now_epoch>
  printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$(( $2 - 60 ))" "$(( $2 + 540 ))" "$1"
}

# Sign the JWT (RS256) with the app private key. Side-effecting (openssl + key).
jwt_sign() { # <app_id> <key_path> <now_epoch> -> signed JWT
  local signing_input sig
  signing_input="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url).$(jwt_payload "$1" "$3" | b64url)"
  sig=$(printf '%s' "$signing_input" | openssl dgst -sha256 -sign "$2" -binary | b64url) || return 1
  printf '%s.%s' "$signing_input" "$sig"
}

# ISO-8601 (…Z) to epoch seconds. Used to store the token's expiry in the cache.
iso_to_epoch() { date -u -d "$1" +%s 2>/dev/null; }

# --- side-effecting API layer (integration-tested on deploy, not in the unit test) -

api() { # <jwt> <method> <path> -> response body on stdout
  curl -sS --fail-with-body -X "$2" \
    -H "Authorization: Bearer $1" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${CW_CLAUDE_API:-https://api.github.com}$3"
}

# The org-wide install has exactly one installation for this app; take the first.
discover_installation_id() { # <jwt> -> installation id
  api "$1" GET /app/installations | jq -e '.[0].id' 2>/dev/null
}

mint() { # writes {token, expires_epoch} to the cache, prints the token
  local app_id key now jwt inst resp token expires_epoch cache
  app_id="${CW_CLAUDE_APP_ID:?CW_CLAUDE_APP_ID not set}"
  key="${CW_CLAUDE_APP_KEY:?CW_CLAUDE_APP_KEY not set}"
  [ -r "$key" ] || { log "app key not readable: $key"; return 1; }
  now=$(date +%s)
  jwt=$(jwt_sign "$app_id" "$key" "$now") || { log "JWT signing failed"; return 1; }
  inst=$(discover_installation_id "$jwt") || { log "installation lookup failed"; return 1; }
  resp=$(api "$jwt" POST "/app/installations/${inst}/access_tokens") || { log "token request failed"; return 1; }
  token=$(printf '%s' "$resp" | jq -re '.token') || { log "no token in response"; return 1; }
  expires_epoch=$(iso_to_epoch "$(printf '%s' "$resp" | jq -r '.expires_at')")
  cache="${CW_CLAUDE_TOKEN_CACHE:-$HOME/.cache/cw-claude/token.json}"
  mkdir -p "$(dirname "$cache")" && (umask 177; printf '{"token":"%s","expires_epoch":%s}\n' "$token" "${expires_epoch:-0}" > "$cache")
  printf '%s\n' "$token"
}

main() {
  local cache token exp
  cache="${CW_CLAUDE_TOKEN_CACHE:-$HOME/.cache/cw-claude/token.json}"
  if [ -r "$cache" ]; then
    token=$(jq -r '.token' "$cache" 2>/dev/null)
    exp=$(jq -r '.expires_epoch' "$cache" 2>/dev/null)
    if [ -n "$token" ] && [ "$(token_fresh "${exp:-0}" "$(date +%s)" "${CW_CLAUDE_TOKEN_SKEW:-300}")" = fresh ]; then
      printf '%s\n' "$token"
      return 0
    fi
  fi
  mint
}

# Do not run main when the file is sourced (the unit test sources it).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
