#!/usr/bin/env bash
# cw-claude-credential — git credential helper that backs GitHub HTTPS auth with a
# cw-claude installation token (minted/cached by cw-claude-token). Wired in via
# git config credential.https://github.com.helper.
#
# git invokes it as `cw-claude-credential <op>` with the request on stdin. We only
# answer `get` for github.com; every other op/host is a no-op so git falls through
# and the token is never handed to any other remote.
set -uo pipefail

# Pure: do we serve a token for this (operation, host)? Guards against leaking the
# token to a non-GitHub remote or on a store/erase call.
should_serve() { # <op> <host> -> "yes"|"no"
  if [ "$1" = get ] && [ "$2" = github.com ]; then echo yes; else echo no; fi
}

main() {
  local op="${1:-}" host="" k v
  while IFS='=' read -r k v; do
    [ "$k" = host ] && host="$v"
  done
  [ "$(should_serve "$op" "$host")" = yes ] || exit 0
  local token
  token=$(cw-claude-token) || exit 1
  printf 'username=x-access-token\n'
  printf 'password=%s\n' "$token"
}

# Do not run main when the file is sourced (the unit test sources it).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
