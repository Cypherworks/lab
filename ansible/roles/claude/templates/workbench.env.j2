{# Sourced by the claude user's login shell. Exposes the cw-claude App id + key
   to cw-claude-token, and sets GH_TOKEN to a fresh installation token for gh.
   git authenticates via the credential helper (cw-claude-credential), not this.
   Claude Code reads CLAUDE_CODE_OAUTH_TOKEN. #}
{% if claude_github_app_id | length > 0 and claude_github_app_private_key | length > 0 %}
export CW_CLAUDE_APP_ID="{{ claude_github_app_id }}"
export CW_CLAUDE_APP_KEY="{{ claude_github_app_key_path }}"
export GH_TOKEN="$(cw-claude-token)"
{% endif %}
{% if claude_oauth_token | length > 0 %}
export CLAUDE_CODE_OAUTH_TOKEN="{{ claude_oauth_token }}"
{% endif %}
