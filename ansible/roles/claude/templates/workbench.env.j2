{# Sourced by the claude user's shell. gh reads GH_TOKEN; git uses gh as its
   credential helper; Claude Code reads CLAUDE_CODE_OAUTH_TOKEN. #}
{% if claude_github_pat | length > 0 %}
export GH_TOKEN="{{ claude_github_pat }}"
{% endif %}
{% if claude_oauth_token | length > 0 %}
export CLAUDE_CODE_OAUTH_TOKEN="{{ claude_oauth_token }}"
{% endif %}
