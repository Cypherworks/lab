{# Patroni config. Managed by postgres_patroni. Automatic failover via etcd3. #}
scope: {{ patroni_scope }}
name: {{ inventory_hostname }}

restapi:
  listen: {{ patroni_this_ip }}:{{ patroni_rest_port }}
  connect_address: {{ patroni_this_ip }}:{{ patroni_rest_port }}
  authentication:
    username: {{ patroni_rest_user }}
    password: "{{ patroni_rest_password }}"

etcd3:
  hosts: {{ patroni_etcd_hosts }}

bootstrap:
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: {{ patroni_this_ip }}:5432
  connect_address: {{ patroni_this_ip }}:5432
  data_dir: {{ patroni_data_dir }}
  bin_dir: {{ patroni_bin_dir }}
  authentication:
    superuser:
      username: postgres
      password: "{{ patroni_superuser_password }}"
      sslmode: verify-full
      sslrootcert: {{ patroni_tls_dir }}/postgres-ca.crt
    replication:
      username: replicator
      password: "{{ patroni_replication_password }}"
      sslmode: verify-full
      sslrootcert: {{ patroni_tls_dir }}/postgres-ca.crt
  parameters:
    max_connections: {{ patroni_max_connections }}
    ssl: "on"
    ssl_cert_file: {{ patroni_tls_dir }}/postgres.crt
    ssl_key_file: {{ patroni_tls_dir }}/postgres.key
    ssl_min_protocol_version: TLSv1.3
  # Patroni writes this whole file on every start and reload.
  pg_hba:
    - local all postgres peer
{% for member in patroni_members %}
    - hostssl all postgres {{ member.ip }}/32 scram-sha-256
{% endfor %}
{% for member in patroni_members %}
    - hostssl replication replicator {{ member.ip }}/32 scram-sha-256
{% endfor %}
{% for db in patroni_databases %}
{% for ip in db.client_ips %}
    - hostssl {{ db.name }} {{ db.owner }} {{ ip }}/32 scram-sha-256
{% endfor %}
{% endfor %}
