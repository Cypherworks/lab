{# Managed by the monitoring role. vmsingle (store+scrape) → vmalert (rules) →
   Alertmanager → Discord and healthchecks.io; Grafana reads vmsingle. Secrets
   via ./.env interpolation. #}
services:
  vmsingle:
    image: {{ monitoring_vmsingle_image }}
    restart: unless-stopped
{% if monitoring_hass_token or monitoring_incus_metrics_targets %}
    # Docker secrets under /run/secrets, read by scrape.yml (HASS bearer token;
    # Incus metrics mTLS client cert + key). Readable to vmsingle's user, never
    # written into the on-disk config.
    secrets:
{% if monitoring_hass_token %}
      - hass_token
{% endif %}
{% if monitoring_incus_metrics_targets %}
      - incus_metrics_cert
      - incus_metrics_key
{% endif %}
{% endif %}
    command:
      - "--storageDataPath=/victoria-metrics-data"
      - "--retentionPeriod={{ monitoring_retention }}"
      - "--promscrape.config=/etc/vm/scrape.yml"
      - "--httpListenAddr=:8428"
      # Delete, snapshots, flags, metrics and the rest refuse without the key.
{% for flag in ['deleteAuthKey', 'snapshotAuthKey', 'forceMergeAuthKey', 'forceFlushAuthKey',
                'search.resetCacheAuthKey', 'configAuthKey', 'reloadAuthKey', 'flagsAuthKey',
                'pprofAuthKey', 'metricsAuthKey'] %}
      - "--{{ flag }}=file:///etc/vm/admin-key"
{% endfor %}
    volumes:
      - vmdata:/victoria-metrics-data
      - {{ monitoring_config_dir }}/scrape.yml:/etc/vm/scrape.yml:ro
      - {{ monitoring_config_dir }}/vmsingle-admin-key:/etc/vm/admin-key:ro
{% if monitoring_alertmanager_api_users %}
      - {{ monitoring_config_dir }}/vmsingle-alertmanager-password:/etc/vm/alertmanager-password:ro
{% endif %}
{% if monitoring_vmsingle_readers or monitoring_vmsingle_writers %}

  # The only way in to vmsingle from outside the stack, on 8428, the port its
  # clients know it by. Readers and writers sign in; admin paths go nowhere.
  vmauth:
    image: {{ monitoring_vmauth_image }}
    restart: unless-stopped
    command:
      - "--auth.config=/etc/vmauth/auth.yml"
      - "--httpListenAddr=:8427"
{% for flag in ['metricsAuthKey', 'flagsAuthKey', 'pprofAuthKey', 'reloadAuthKey'] %}
      - "--{{ flag }}=file:///etc/vmauth/admin-key"
{% endfor %}
    volumes:
      - {{ monitoring_config_dir }}/vmauth.yml:/etc/vmauth/auth.yml:ro
      - {{ monitoring_config_dir }}/vmsingle-admin-key:/etc/vmauth/admin-key:ro
    ports:
      - "8428:8427"
    depends_on:
      - vmsingle
{% endif %}

  vmalert:
    image: {{ monitoring_vmalert_image }}
    restart: unless-stopped
    command:
      - "--datasource.url=http://vmsingle:8428"
      - "--remoteWrite.url=http://vmsingle:8428"
      - "--notifier.url=http://alertmanager:9093"
{% if monitoring_alertmanager_api_users %}
      - "--notifier.basicAuth.username=vmalert"
      - "--notifier.basicAuth.passwordFile=/etc/vmalert/notifier-password"
{% endif %}
      - "--rule=/etc/vmalert/alert-rules.yml"
    volumes:
      - {{ monitoring_config_dir }}/alert-rules.yml:/etc/vmalert/alert-rules.yml:ro
{% if monitoring_alertmanager_api_users %}
      - {{ monitoring_config_dir }}/vmalert-notifier-password:/etc/vmalert/notifier-password:ro
{% endif %}
    depends_on:
      - vmsingle
      - alertmanager
{% if monitoring_log_rules %}

  # LogsQL rules counting log lines into vmsingle; vmalert takes one datasource.
  vmalert-logs:
    image: {{ monitoring_vmalert_logs_image }}
    restart: unless-stopped
    command:
      - "--datasource.url=http://victorialogs:9428"
      - "--remoteWrite.url=http://vmsingle:8428"
      - "--rule=/etc/vmalert/log-rules.yml"
    volumes:
      - {{ monitoring_config_dir }}/log-rules.yml:/etc/vmalert/log-rules.yml:ro
    depends_on:
      - vmsingle
      - victorialogs
{% endif %}

  alertmanager:
    image: {{ monitoring_alertmanager_image }}
    restart: unless-stopped
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
{% if monitoring_alertmanager_api_users %}
      - "--web.config.file=/etc/alertmanager/secrets/web.yml"
{% endif %}
    volumes:
      - {{ monitoring_config_dir }}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - {{ monitoring_config_dir }}/alertmanager-templates:/etc/alertmanager/templates:ro
      - {{ monitoring_config_dir }}/alertmanager-secrets:/etc/alertmanager/secrets:ro
      - amdata:/alertmanager
{% if monitoring_alertmanager_api_users %}
    ports:
      - "9093:9093"
{% endif %}

  redis_exporter:
    image: {{ monitoring_redis_exporter_image }}
    restart: unless-stopped
    environment:
      REDIS_PASSWORD: "${REDIS_PASSWORD}"
    ports:
      - "9121:9121"

  # https cert-expiry probes. vmsingle drives it via the blackbox-https scrape job.
  blackbox:
    image: {{ monitoring_blackbox_image }}
    restart: unless-stopped
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
    volumes:
      - {{ monitoring_config_dir }}/blackbox.yml:/etc/blackbox/blackbox.yml:ro

  # Synology NAS over SNMPv3. snmp.yml carries the module OIDs; the v3 auth/priv
  # passwords come from the container env (./.env) and are expanded into the config
  # at load time via --config.expand-environment-variables, so no plaintext secrets
  # land in the on-disk config file.
  snmp_exporter:
    image: {{ monitoring_snmp_exporter_image }}
    restart: unless-stopped
    command:
      - "--config.file=/etc/snmp_exporter/snmp.yml"
      - "--config.expand-environment-variables"
    environment:
      SNMP_V3_AUTH_PASSWORD: "${SNMP_V3_AUTH_PASSWORD}"
      SNMP_V3_PRIV_PASSWORD: "${SNMP_V3_PRIV_PASSWORD}"
    volumes:
      - {{ monitoring_config_dir }}/snmp.yml:/etc/snmp_exporter/snmp.yml:ro

  # RTSP→MSE/WebRTC/HLS restream for the CCTV strip. The camera RTSP URLs carry
  # access tokens, so they come from the container env (./.env) and go2rtc expands
  # the ${...} placeholders in go2rtc.yaml at load time — no plaintext on disk.
  # Reached only via Caddy on the lab domain; the embed uses MSE (single HTTP port).
  go2rtc:
    image: {{ monitoring_go2rtc_image }}
    restart: unless-stopped
    environment:
      GO2RTC_FRONT_URL: "${GO2RTC_FRONT_URL}"
      GO2RTC_GARAGE_CARPORT_URL: "${GO2RTC_GARAGE_CARPORT_URL}"
{% if monitoring_go2rtc_username %}
      GO2RTC_USERNAME: "${GO2RTC_USERNAME}"
      GO2RTC_PASSWORD: "${GO2RTC_PASSWORD}"
{% endif %}
    volumes:
      - {{ monitoring_config_dir }}/go2rtc.yaml:/config/go2rtc.yaml:ro
    ports:
      - "{{ monitoring_go2rtc_api_port }}:{{ monitoring_go2rtc_api_port }}"

  grafana:
    image: {{ monitoring_grafana_image }}
    restart: unless-stopped
    env_file: ./.env
    environment:
      GF_SERVER_ROOT_URL: "{{ monitoring_grafana_root_url }}"
{% if monitoring_grafana_anonymous_enabled %}
      # Anonymous view-only for the wall kiosk. Grafana is lab-only (no external /
      # overlay ingress), and admin/edit stays behind Authentik OIDC (Viewer role).
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: "Viewer"
{% endif %}
      GF_SECURITY_ADMIN_USER: "{{ monitoring_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD}"
      GF_AUTH_GENERIC_OAUTH_ENABLED: "true"
      GF_AUTH_GENERIC_OAUTH_NAME: "Authentik"
      GF_AUTH_GENERIC_OAUTH_CLIENT_ID: "${GRAFANA_OIDC_CLIENT_ID}"
      GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: "${GRAFANA_OIDC_CLIENT_SECRET}"
      GF_AUTH_GENERIC_OAUTH_SCOPES: "openid profile email"
      GF_AUTH_GENERIC_OAUTH_AUTH_URL: "{{ monitoring_grafana_oidc_auth_url }}"
      GF_AUTH_GENERIC_OAUTH_TOKEN_URL: "{{ monitoring_grafana_oidc_token_url }}"
      GF_AUTH_GENERIC_OAUTH_API_URL: "{{ monitoring_grafana_oidc_api_url }}"
      GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: "{{ monitoring_grafana_role_path }}"
      GF_AUTH_SIGNOUT_REDIRECT_URL: "{{ monitoring_grafana_oidc_signout_url }}"
      # Allow the CCTV text panel to render its go2rtc <iframe>. Scoped to the text
      # panel only; Grafana stays behind Authentik OIDC. Not allow_embedding — that's
      # for embedding Grafana elsewhere, which we don't do.
      GF_PANELS_DISABLE_SANITIZE_HTML: "true"
      # Run only the plugins the pinned image ships; fetch none at startup.
      GF_PLUGINS_PREINSTALL_DISABLED: "true"
    volumes:
      - grafanadata:/var/lib/grafana
      - {{ monitoring_config_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_config_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
      # Empty and read-only: hides plugins already downloaded into the volume.
      - {{ monitoring_config_dir }}/grafana/plugins:/var/lib/grafana/plugins:ro
    ports:
      - "3000:3000"
    depends_on:
      - vmsingle

  # Central log store. Vector agents on every host/container ship journald here via the
  # Elasticsearch bulk endpoint; read it in its own UI, not Grafana (anonymous Viewer).
  # Port published so off-box agents on VLAN 20/30 can reach it.
  victorialogs:
    image: {{ monitoring_victorialogs_image }}
    restart: unless-stopped
    command:
      - "--storageDataPath=/victoria-logs-data"
      - "--retentionPeriod={{ monitoring_logs_retention }}"
      - "--httpListenAddr=:9428"
{% if monitoring_victorialogs_syslog_port %}
      # Devices that only speak syslog, such as the firewall. RFC3164 stamps
      # carry no zone or year, so lines are stamped on receipt.
      - "--syslog.listenAddr.udp=:514"
      - "--syslog.useLocalTimestamp.udp=true"
      - "--syslog.useRemoteIP.udp=true"
{% endif %}
    volumes:
      - victorialogsdata:/victoria-logs-data
    ports:
      - "9428:9428"
{% if monitoring_victorialogs_syslog_port %}
      - "{{ monitoring_victorialogs_syslog_port }}:514/udp"
{% endif %}

volumes:
  vmdata:
  amdata:
  grafanadata:
  victorialogsdata:
{% if monitoring_hass_token or monitoring_incus_metrics_targets %}

# File-based docker secrets — 0600 on the host, mounted read-only into vmsingle.
secrets:
{% if monitoring_hass_token %}
  hass_token:
    file: {{ monitoring_config_dir }}/hass_token
{% endif %}
{% if monitoring_incus_metrics_targets %}
  incus_metrics_cert:
    file: {{ monitoring_config_dir }}/incus_metrics.crt
  incus_metrics_key:
    file: {{ monitoring_config_dir }}/incus_metrics.key
{% endif %}
{% endif %}
