{# Managed by the monitoring role. Alerts go to Discord, the heartbeat to
   healthchecks.io. Both are outside the lab, so their URLs are secrets read
   from files, and what they're sent goes through alert-text.tmpl. A receiver
   with no URL set receives nothing. #}
{% macro receiver(name, webhook_url) %}
  - name: {{ name }}
{% if webhook_url %}
    discord_configs:
      - webhook_url_file: /etc/alertmanager/secrets/discord-{{ name }}
        title: '{% raw %}{{ template "lab.title" . }}{% endraw %}'
        message: '{% raw %}{{ template "lab.message" . }}{% endraw %}'
{% endif %}
{% endmacro %}
templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: warning
  group_by: [alertname, instance]
  group_wait: 10s
  # A group holds one alert, so this only holds back its resolve and repeats.
  group_interval: 30s
  repeat_interval: {{ monitoring_alertmanager_repeat_interval }}
  routes:
{% if monitoring_healthchecks_ping_url %}
    - matchers: ['alertname="Watchdog"']
      receiver: heartbeat
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 30s
{% endif %}
    - matchers: ['severity="critical"']
      receiver: critical
    - matchers: ['severity="warning"']
      receiver: warning
      group_wait: {{ monitoring_alertmanager_warning_wait }}

receivers:
{{ receiver('critical', monitoring_discord_critical_webhook_url) -}}
{{ receiver('warning', monitoring_discord_warning_webhook_url) -}}
{% if monitoring_healthchecks_ping_url %}
  - name: heartbeat
    webhook_configs:
      - url_file: /etc/alertmanager/secrets/healthchecks-ping
        send_resolved: false
{% endif %}
