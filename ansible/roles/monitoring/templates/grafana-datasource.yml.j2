{# Managed by the monitoring role. VictoriaMetrics as a Prometheus-type datasource.
   Anonymous Viewer can query any datasource, so VictoriaLogs isn't one. #}
apiVersion: 1
{# Dropping an entry leaves it in Grafana's database, still queryable. #}
deleteDatasources:
  - name: VictoriaLogs
    orgId: 1
datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: http://vmsingle:8428
    isDefault: true
    jsonData:
      timeInterval: "{{ monitoring_scrape_interval }}"
