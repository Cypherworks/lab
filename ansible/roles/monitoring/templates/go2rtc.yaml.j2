{# Managed by the monitoring role. RTSP→MSE/WebRTC/HLS restream for the CCTV strip.
   The RTSP source URLs carry access tokens, so they never land here in plaintext:
   go2rtc expands ${VAR} from the environment at load time (env injected via ./.env),
   exactly like snmp_exporter's --config.expand-environment-variables pattern. #}
api:
  listen: ":{{ monitoring_go2rtc_api_port }}"
{% if monitoring_go2rtc_username %}
  username: ${GO2RTC_USERNAME}
  password: ${GO2RTC_PASSWORD}
{% endif %}

# Restreams. The browser plays these via MSE (pure HTTP/WS — proxies cleanly through
# Caddy on one TLS port). WebRTC needs direct UDP/TCP 8555 and is left for on-LAN use.
{# Transcode through go2rtc's bundled ffmpeg for H.265 cameras (browser MSE only
   plays H.264) and for sources with no H.264 parameter sets in their SDP: go2rtc
   then gives MSE a placeholder 128x96 header, and the browser draws 4:3. The
   camera is a separate stream because beside a raw H.264 source the ffmpeg one
   is never picked. #}
{% if monitoring_go2rtc_video_transcode and monitoring_go2rtc_video_fps %}
{# go2rtc's h264 with 2s keyframes; its MSE player only keeps 5s. #}
ffmpeg:
  h264: "-c:v libx264 -g {{ (monitoring_go2rtc_video_fps | int) * 2 }} -profile:v high -level:v 4.1 -preset:v superfast -tune:v zerolatency -pix_fmt:v yuv420p"

{% endif %}
{# One camera's transcode: the frame rate limit, then its video filter. #}
{% macro transcoded(stream, filter) -%}
ffmpeg:{{ stream }}_source#video=h264{% if monitoring_go2rtc_video_fps %}#raw=-r {{ monitoring_go2rtc_video_fps }}{% endif %}{% if filter %}#raw=-vf {{ filter }}{% endif %}
{%- endmacro %}
streams:
  front:
{% if monitoring_go2rtc_video_transcode %}
    - {{ transcoded('front', monitoring_go2rtc_front_video_filter) }}
  front_source:
{% endif %}
    - ${GO2RTC_FRONT_URL}
  garage_carport:
{% if monitoring_go2rtc_video_transcode %}
    - {{ transcoded('garage_carport', monitoring_go2rtc_garage_carport_video_filter) }}
  garage_carport_source:
{% endif %}
    - ${GO2RTC_GARAGE_CARPORT_URL}
