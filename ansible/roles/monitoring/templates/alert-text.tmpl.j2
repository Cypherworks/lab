{# Managed by the monitoring role. Text for receivers outside the lab. Every rule
   goes through lab.redact, so a label holding a URL can't take an FQDN or an
   address out of the lab, whatever a rule prints. #}
{% raw %}
{{ define "lab.redact" -}}
{{ . | reReplaceAll `https?://([^./\s]+)\S*` "${1}" | reReplaceAll `\b([a-zA-Z0-9-]+)(\.[a-zA-Z0-9-]+)*\.[a-zA-Z]{2,}\b` "${1}" | reReplaceAll `\b\d{1,3}(\.\d{1,3}){3}(:\d+)?\b` "[address]" }}
{{- end }}

{{ define "lab.title" -}}
{{ if eq .Status "resolved" }}Resolved: {{ end }}{{ template "lab.redact" (or .CommonAnnotations.summary .CommonLabels.alertname) }}
{{- end }}

{{ define "lab.message" -}}
{{ template "lab.redact" .CommonAnnotations.description }}
{{- end }}
{% endraw %}
