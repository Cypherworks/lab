{# Managed by the monitoring role. vmalert rules. Thresholds are Jinja; the alert
   templating ({{ '{{ ... }}' }}) is escaped so it survives to the rendered file. #}
groups:
  - name: lab
    # Twice vmalert's default, so an outage reaches a receiver sooner.
    interval: 30s
    rules:
{% if monitoring_healthchecks_ping_url %}
      # Always firing. healthchecks.io alerts when these stop arriving.
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "Heartbeat"

{% endif %}
      - alert: HighCPUTemperature
        expr: (max by (instance) (node_hwmon_temp_celsius) > {{ monitoring_temp_warn_celsius }}) or (max by (instance) (node_thermal_zone_temp) > {{ monitoring_temp_warn_celsius }})
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High CPU temperature on {{ '{{ $labels.instance }}' }}"
          description: "{{ '{{ $value }}' }}°C (warn at {{ monitoring_temp_warn_celsius }}°C)"

      - alert: TargetDown
        expr: up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Target down: {{ '{{ $labels.job }} / {{ $labels.instance }}' }}"
          description: "No metrics scraped for a minute."

      # `up` only proves blackbox answered, so TargetDown can't see these.
      - alert: ServiceDown
        expr: probe_success{job=~"service-health|dns"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Service down: {{ '{{ $labels.job }} / {{ $labels.instance }}' }}"
          description: "Health probe failing for a minute."
{% if monitoring_incus_instances %}

      # Incus drops every series of a stopped instance, so look for none.
      - alert: InstanceNotRunning
        expr: '{% for name in monitoring_incus_instances %}absent(incus_procs_total{name="{{ name }}"}){{ " or " if not loop.last }}{% endfor %}'
        for: 1m
        labels:
          severity: critical
          # Alertmanager groups and the kiosk lists alerts by instance.
          instance: "{{ '{{ $labels.name }}' }}"
        annotations:
          summary: "Instance not running: {{ '{{ $labels.name }}' }}"
          description: "Incus has reported nothing for it for a minute."
{% endif %}

      - alert: DiskFilling
        expr: 100 * (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"} / node_filesystem_size_bytes) > {{ monitoring_disk_used_percent }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Disk filling on {{ '{{ $labels.instance }}' }} ({{ '{{ $labels.mountpoint }}' }})"
          description: "Over {{ monitoring_disk_used_percent }}% used."

      - alert: FilesystemReadOnly
        expr: node_filesystem_readonly{fstype!~"tmpfs|overlay|squashfs"} == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Filesystem read-only on {{ '{{ $labels.instance }}' }} ({{ '{{ $labels.mountpoint }}' }})"
          description: "The filesystem was remounted read-only — usually a storage or corruption error. Check dmesg and btrfs device stats now."

      - alert: PatroniNoPrimary
        expr: sum by (cluster) (patroni_primary) < 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Patroni has no primary: {{ '{{ $labels.cluster }}' }}"
          description: "No PostgreSQL primary in the {{ '{{ $labels.cluster }}' }} cluster. Auto-failover may be stuck."
{% if monitoring_blackbox_targets %}

      - alert: CertExpiringSoon
        expr: label_replace(probe_ssl_earliest_cert_expiry - time() < 86400 * {{ monitoring_cert_expiry_warn_days }}, "host", "$1", "instance", "(?:https://)?([^.]+).*")
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS cert expiring soon: {{ '{{ $labels.host }}' }}"
          description: "Under {{ monitoring_cert_expiry_warn_days }} days left, so renewal has been failing."

      # A failed probe reports no expiry, so the rule above can't fire for it.
      - alert: CertNotProbed
        expr: (count(probe_ssl_earliest_cert_expiry) or vector(0)) < {{ (monitoring_blackbox_targets + monitoring_blackbox_node_tls_targets) | length }}
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS cert probe not reporting"
          description: "Fewer targets reporting a cert than configured, so an expiry could go unseen."
{% endif %}

      # Certs on disk from openbao_cert renew only when their play runs.
      - alert: CertRenewalDue
        expr: tls_cert_not_after_seconds - time() < 86400 * {{ monitoring_cert_file_renew_days }}
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS cert renewal due: {{ '{{ $labels.cert }}' }} on {{ '{{ $labels.instance }}' }}"
          description: "Under {{ monitoring_cert_file_renew_days }} days left; the play that deploys it reissues it."

      - alert: RedisDown
        expr: redis_up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Redis unreachable: {{ '{{ $labels.instance }}' }}"
          description: "redis_exporter cannot reach the instance."
{% for source in monitoring_pushed_metrics %}

      # A pushed source has no scrape to fail, so watch its push timestamp.
      - alert: PushedMetricsStale
        expr: (time() - max({{ source.metric }}) > {{ monitoring_pushed_metrics_stale_seconds }}) or absent({{ source.metric }})
        for: 2m
        labels:
          severity: warning
          instance: "{{ source.name }}"
        annotations:
          summary: "No metrics pushed from {{ source.name }}"
          description: "Its last push is over {{ monitoring_pushed_metrics_stale_seconds }} seconds old, or there has been none."
{% endfor %}
{% if monitoring_not_logging_metric %}

      # A down system is TargetDown's; an absent log count fires for every system.
      - alert: NotLogging
        expr: (up{job=~"{{ monitoring_not_logging_jobs | join('|') }}"} == 1) unless on(instance) label_replace(max_over_time({{ monitoring_not_logging_metric }}[{{ monitoring_not_logging_window }}]), "instance", "$1", "host", "(.*)")
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "No logs from {{ '{{ $labels.instance }}' }}"
          description: "Up and scraped, but no log line from it in {{ monitoring_not_logging_window }}."
{% endif %}

      # From the apt_maintenance role: a weekly slot missed, deferred or failed.
      - alert: MaintenanceOverdue
        expr: time() - apt_maintenance_last_success_timestamp_seconds > {{ monitoring_maintenance_overdue_days }} * 86400
        labels:
          severity: warning
        annotations:
          summary: "Not patched for {{ monitoring_maintenance_overdue_days }} days: {{ '{{ $labels.instance }}' }}"
          description: "No successful apt maintenance run in {{ monitoring_maintenance_overdue_days }} days."
{% for rule in monitoring_alert_rules %}

{{ [rule] | to_nice_yaml(indent=2, width=1000) | trim | indent(6, first=True) }}
{% endfor %}
