#!/usr/bin/env bash
# Managed by Ansible (github_runner role). The runner runs this before every
# job (ACTIONS_RUNNER_HOOK_JOB_STARTED). It clears everything earlier jobs
# left on the Docker daemon, keeping only this runner's own container and its
# image: a fixed container name from a cancelled run can't break the next
# job, and no job builds on an image or cache layer another repo's job made.
# Exiting non-zero fails the job before its first step.
set -euo pipefail

runner={{ github_runner_name | quote }}

mapfile -t leftovers < <(
  docker ps --all --format '{{ '{{' }}.Names{{ '}}' }}' | grep --invert-match --line-regexp --fixed-strings "$runner" || true
)
if [[ -n "${leftovers[*]}" ]]; then
  echo "Removing containers earlier jobs left: ${leftovers[*]}"
  docker rm --force --volumes "${leftovers[@]}" >/dev/null
fi
docker system prune --all --force
docker volume prune --all --force
