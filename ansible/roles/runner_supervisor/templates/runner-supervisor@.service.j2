# Managed by Ansible (runner_supervisor role). One instance per Incus VM
# (%i). Root with no capabilities, as technitium_dns's metrics writer runs,
# so it can write node_exporter's root-owned textfile directory and nothing
# else outside its state directory.
[Unit]
Description=Docker runner supervisor for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=INCUS_CONF={{ runner_supervisor_conf_dir }}
ExecStart=/usr/local/bin/runner-supervisor -vm %i -org {{ runner_supervisor_org }} -remote {{ runner_supervisor_remote_name }} -project {{ runner_supervisor_project }} -labels {{ runner_supervisor_labels | join(',') }} -token-file {{ runner_supervisor_token_file }} -incus {{ runner_supervisor_incus }} -github-url {{ runner_supervisor_github_url }}{{ (' -metrics-dir ' ~ runner_supervisor_metrics_dir) if runner_supervisor_metrics_dir else '' }}
Restart=always
RestartSec=30
# Exit 3: the VM's reset kept failing and it is left stopped.
RestartPreventExitStatus=3
TimeoutStopSec={{ runner_supervisor_stop_timeout }}
StateDirectory={{ runner_supervisor_state_dir | basename }}
StateDirectoryMode=0700
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
{% if runner_supervisor_metrics_dir %}
ReadWritePaths={{ runner_supervisor_metrics_dir }}
{% endif %}
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
