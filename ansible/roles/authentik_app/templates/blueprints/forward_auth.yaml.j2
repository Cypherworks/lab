# Managed by the authentik_app role. Forward-auth (proxy) providers on the embedded
# outpost, so Caddy gates non-OIDC apps behind an Authentik login. Per app in
# authentik_forward_auth_apps: a per-app group (default-deny), a forward_single proxy
# provider, an application, and a policy binding. All providers attach to the embedded
# outpost, which serves /outpost.goauthentik.io/auth/caddy on the server's own :9000.
version: 1
metadata:
  name: lab - forward auth
entries:
{% for app in authentik_forward_auth_apps %}
  - model: authentik_core.group
    id: group-fa-{{ app.slug }}
    identifiers:
      name: {{ app.group }}
    attrs:
      name: {{ app.group }}

  - model: authentik_providers_proxy.proxyprovider
    id: provider-fa-{{ app.slug }}
    identifiers:
      name: "{{ app.name }}"
    attrs:
      name: "{{ app.name }}"
      mode: forward_single
      external_host: "{{ app.external_host }}"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]

  - model: authentik_core.application
    id: app-fa-{{ app.slug }}
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: "{{ app.name }}"
      slug: {{ app.slug }}
      provider: !KeyOf provider-fa-{{ app.slug }}
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-fa-{{ app.slug }}
      group: !KeyOf group-fa-{{ app.slug }}
      order: 0
    attrs:
      enabled: true
{% endfor %}
{% if authentik_forward_auth_apps %}

  # Attach every forward-auth provider to the embedded outpost. Only `providers` is
  # set, so the outpost's managed config is left intact.
  - model: authentik_outposts.outpost
    identifiers:
      name: authentik Embedded Outpost
    attrs:
      providers:
{% for app in authentik_forward_auth_apps %}
        - !KeyOf provider-fa-{{ app.slug }}
{% endfor %}
{% endif %}
