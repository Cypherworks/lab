{# Managed by Ansible (technitium_dns). Mirrors upstream's systemd.service, #}
{# with the distro dotnet instead of /opt/dotnet. #}
[Unit]
Description=Technitium DNS Server
After=network-online.target
Wants=network-online.target

[Service]
User={{ technitium_dns_user }}
Group={{ technitium_dns_user }}
WorkingDirectory={{ technitium_dns_install_dir }}
ExecStart={{ technitium_dns_dotnet }} {{ technitium_dns_install_dir }}/DnsServerApp.dll {{ technitium_dns_config_dir }}
Environment=OPENSSL_ENABLE_SHA1_SIGNATURES=1
Restart=always
RestartSec=10
KillSignal=SIGINT
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ technitium_dns_config_dir }} {{ technitium_dns_log_dir }}

[Install]
WantedBy=multi-user.target
